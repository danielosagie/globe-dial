{
  "name": "globe-dial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "node scripts/render.mjs",
    "render:png": "remotion render src/remotion/index.ts GlobeVideo out/frames --sequence --image-format=png",
    "still": "remotion still src/remotion/index.ts GlobeStill out/globe.png"
  },
  "dependencies": {
    "cobe": "0.6.4",
    "dialkit": "^1.4.3",
    "mediabunny": "^1.51.0",
    "motion": "^12.42.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.489",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "remotion": "4.0.489",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@11.9.0"
}
